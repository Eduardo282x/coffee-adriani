# Configuración de build del frontend.
# Copiar a .env y ajustar. NUNOMBRE subir el .env real al repositorio.

# Origen del backend: dominio completo, sin barra final. El cliente construye
# `${VITE_BASE_URL_API}/api` y conecta el WebSocket a `${VITE_BASE_URL_API}/ws`.
#
# En Dokploy esto además debe estar declarado como build arg del build de Docker,
# o el build falla (ver el guard en vite.config.ts).
VITE_BASE_URL_API=http://localhost:3002

# Tolerancia de pago en USD. Opcional: si no se define, se usa la del backend.
# VITE_PAYMENT_TOLERANCE_USD=0.05
